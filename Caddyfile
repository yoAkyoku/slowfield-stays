{
	auto_https off

	# Who is allowed to tell us who the visitor is.
	#
	# The backend reads `CF-Connecting-IP` to key its rate limiters and to stamp
	# the login audit. Nothing verified it. Cloudflare overwrites that header, so
	# it is honest for traffic that came through Cloudflare — but this origin also
	# answers :443 directly (auto_https off, mounted origin certificates), so
	# anyone who learns the origin address could set the header themselves and
	# send a different value on every request: every limiter bypassed, and any
	# address they like written into the audit trail of a sign-in.
	#
	# With these ranges declared, `{client_ip}` below is resolved by Caddy rather
	# than asserted by the caller, and the handlers overwrite the header with it.
	#
	# Failure mode if this list goes stale: Cloudflare traffic stops being
	# recognised, `{client_ip}` falls back to the immediate peer, and the limiters
	# key on Cloudflare's own addresses — degraded, NOT down. That is deliberate;
	# an allowlist that blocks instead would take the site off the air the day
	# Cloudflare adds a range.
	#
	# Source: https://www.cloudflare.com/ips-v4 and /ips-v6 (fetched 2026-08-30).
	# Re-check when Cloudflare announces new ranges.
	# One line on purpose: line continuations are a parser detail this config
	# cannot afford to be wrong about, and a Caddyfile that fails to parse is an
	# offline site.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

:443 {
	# Not Let's Encrypt: these are manually mounted origin certificates
	# (./certs, bind-mounted read-only by docker-compose.prod.yml). If that
	# directory is missing, Docker creates an EMPTY one rather than failing, and
	# Caddy then cannot start — which takes the whole site offline. Verify the
	# two files exist before every deploy.
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	# An access log, so a production incident has something to look at.
	# Caddy v2 writes none unless asked, so until now there was no record of who
	# requested what, and no way to see a 5xx rate at all.
	log {
		output stdout
		format json
	}

	# Headers for every route, not just the ones Next serves.
	#
	# The security headers all came from next.config.mjs, which only covers
	# responses proxied to the frontend — so /api/* and /healthz answered with no
	# nosniff and no HSTS. These sit at the top level of the site block, so all
	# four handles below inherit them; Next's own header block still applies on
	# top for the routes it serves.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Caddy advertises itself by default; there is no reason to.
		-Server
	}

	# `header_up` OVERWRITES, which is the point: whatever the caller sent under
	# this name is discarded and replaced with the address Caddy resolved using
	# the trusted_proxies list above. Through Cloudflare that is the real
	# visitor; straight to the origin it is the caller's own address, so someone
	# trying to forge a different one now rate-limits themselves.
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up CF-Connecting-IP {client_ip}
		}
	}

	handle /healthz {
		reverse_proxy backend:8000 {
			header_up CF-Connecting-IP {client_ip}
		}
	}

	handle /storage/* {
		reverse_proxy backend:8000 {
			header_up CF-Connecting-IP {client_ip}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}

:80 {
	redir https://{host}{uri} permanent
}
